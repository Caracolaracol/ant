---
// Portada del sitio en inglés o español: una cámara por idea, en pisos de tres que se recorren en
// zigzag (ver `lib/hormiguero.ts`); «Cámaras cifradas» (`data-ramal`) queda en un ramal que sale
// del costado de «El hormiguero» y se visita con un chevron. Presenta
// Ant como un lugar simple, inteligente y sin distracciones para escribir: primero para
// escritores (cuentos, novelas); después el hormiguero y sus cámaras (cómo se ordenan las notas),
// las cámaras cifradas, las notas de todos los días, los desarrolladores, lo que la hace
// inteligente, lo liviana que es, sus atajos y el cierre. Los textos son cortos a propósito: lo
// largo va en la documentación.
import Nido from '../layouts/Nido.astro';
import VentanaAnt from './VentanaAnt.astro';
import { Image } from 'astro:assets';
import { ruta, rutaDe, sitio, traductor, type Idioma } from '../lib/sitio';
import capturaDeLasCamarasEnIngles from '../assets/ajustes-camaras-en.png';
import capturaDeLasCamarasEnEspanol from '../assets/ajustes-camaras-es.png';

interface Props { idioma: Idioma; }
const { idioma } = Astro.props;
const t = traductor(idioma);
const docs = rutaDe(idioma, 'docs');
const instalar = `${docs}#${t('install', 'instalar')}`;

// Captura del hormiguero y las cámaras de Ajustes → General, con un hormiguero de ejemplo, para la cámara «El
// hormiguero». Sale de `prueba/barra.html?ajustes&captura` (con `&es` en español), a 2x con Chrome
// sin ventana; ver el comentario de `?captura` en `prueba/barra.tsx` para volver a sacarla.
const capturaDeLasCamaras = idioma === 'es' ? capturaDeLasCamarasEnEspanol : capturaDeLasCamarasEnIngles;
---
<Nido
  idioma={idioma}
  seccion="inicio"
  titulo={t('Ant · write without distractions', 'Ant · escribe sin distracciones')}
  descripcion={t(
    'Ant is a simple, smart, distraction-free desktop app for writing: stories, novels, notes and code, saved as plain Markdown files on your disk.',
    'Ant es una app de escritorio simple, inteligente y sin distracciones para escribir: cuentos, novelas, notas y código, guardados como archivos Markdown en tu disco.',
  )}
>

  <section class="camara portada" id={t('home', 'inicio')} data-nombre={t('Home', 'Inicio')}>
    <div class="hueco">
      <img class="portada-icono" src={ruta('ant-icono.svg')} width="220" height="220" alt={t('Ant icon: the face of a yellow ant', 'Icono de Ant: la cara de una hormiga amarilla')} />
      <div>
        <h1>Ant<span>.</span></h1>
        <p class="lema">{t('Write without distractions.', 'Escribe sin distracciones.')}</p>
        <p class="sublema">{t('Simple, smart and quiet. Plain Markdown files on your disk.', 'Simple, inteligente y silenciosa. Archivos Markdown en tu disco.')}</p>
        <div class="acciones">
          <a class="boton lleno" href={instalar}>{t('Download', 'Descargar')}</a>
          <a class="boton" href={docs}>{t('Documentation', 'Documentación')}</a>
          <a class="boton" href={sitio.repo}>GitHub ↗</a>
        </div>
        <p class="pista-scroll">{t('Follow the tunnel', 'Sigue el túnel')} <span class="flecha" aria-hidden="true">→</span></p>
      </div>
    </div>
  </section>

  <section class="camara" id={t('writers', 'escritores')} data-nombre={t('For writers', 'Para escritores')}>
    <div class="hueco bloques">
      <div class="bloque">
        <p class="etiqueta">{t('For writers', 'Para escritores')}</p>
        <h2>{t('Your manuscript, nothing else', 'Tu manuscrito, nada más')}</h2>
        <p>{t('Just the page and the cursor. No toolbars, no panels.', 'Solo la página y el cursor. Sin barras ni paneles.')}</p>
        <p class="tenue">{t('Chapters in the sidebar, word count at the bottom.', 'Los capítulos en la barra lateral, las palabras abajo.')}</p>
      </div>
      <VentanaAnt idioma={idioma} />
    </div>
  </section>

  <section class="camara" id={t('anthill', 'hormiguero')} data-nombre={t('The anthill', 'El hormiguero')}>
    <div class="hueco bloques">
      <div class="bloque">
        <p class="etiqueta">{t('One anthill, many chambers', 'Un hormiguero, muchas cámaras')}</p>
        <h2>{t('A chamber for each part of your life', 'Una cámara para cada parte de tu vida')}</h2>
        <p>{t('Your notes live in one folder, the anthill. Each chamber inside is one context: a novel, your diary, your work.', 'Tus notas viven en una carpeta, el hormiguero. Cada cámara es un contexto: una novela, tu diario, tu trabajo.')}</p>
        <p class="tenue">{t('Each one with its own pins, diary and editor.', 'Cada una con sus fijados, su diario y su editor.')}</p>
      </div>
      <Image class="captura" src={capturaDeLasCamaras} width={400} densities={[1, 2]} loading="eager" alt={t('Ant’s Settings: the anthill folder and its chambers (Entrance, Novel, Personal, Work and Vault, which is encrypted), with controls to open, rename or encrypt chambers, and New chamber at the end', 'Ajustes de Ant: la carpeta del hormiguero y sus cámaras (Entrada, Novela, Personal, Trabajo y Bóveda, que está cifrada), con controles para abrir, renombrar o cifrar cámaras, y Cámara nueva al final')} />
    </div>
  </section>

  <section class="camara" id={t('vault', 'boveda')} data-nombre={t('Encrypted chambers', 'Cámaras cifradas')} data-ramal>
    <div class="hueco bloques">
      <div class="bloque">
        <p class="etiqueta">{t('Encrypted chambers', 'Cámaras cifradas')}</p>
        <h2>{t('A chamber only you can open', 'Una cámara que solo tú abres')}</h2>
        <p>{t('You can lock a chamber with a password. On your disk or in the cloud, nobody else can read it.', 'Puedes cerrar una cámara con contraseña. En tu disco o en la nube, nadie más puede leerla.')}</p>
        <p class="tenue">{t('Forget the password and it is lost. On purpose.', 'Si olvidas la contraseña, se pierde. A propósito.')}</p>
      </div>
    </div>
  </section>

  <section class="camara" id={t('notes', 'notas')} data-nombre={t('For notes', 'Para notas')}>
    <div class="hueco bloques">
      <div class="bloque">
        <p class="etiqueta">{t('For everyday notes', 'Para tus notas')}</p>
        <h2>{t('Ideas, lists, journals', 'Ideas, listas, diarios')}</h2>
        <p>{t('Pin what you use most, keep a diary, paste images, check off tasks.', 'Fija lo que más usas, lleva un diario, pega imágenes, marca tareas.')}</p>
      </div>
      <div class="bloque">
        <div class="sellos">
          <div><b>0</b><span>{t('accounts', 'cuentas')}</span></div>
          <div><b>0</b><span>{t('clouds', 'nubes')}</span></div>
          <div><b>.md</b><span>{t('plain files', 'archivos simples')}</span></div>
        </div>
        <p class="tenue">{t('Your notes are files you own.', 'Tus notas son archivos tuyos.')}</p>
      </div>
    </div>
  </section>

  <section class="camara" id={t('developers', 'desarrolladores')} data-nombre={t('For developers', 'Para desarrolladores')}>
    <div class="hueco bloques">
      <div class="bloque">
        <p class="etiqueta">{t('For developers', 'Para desarrolladores')}</p>
        <h2>{t('Plain text, keyboard first', 'Texto plano, primero el teclado')}</h2>
        <ul>
          <li>{t('Highlighted code in dozens of languages.', 'Código resaltado en decenas de lenguajes.')}</li>
          <li>{t('Code blocks and brackets close themselves.', 'Bloques y paréntesis que se cierran solos.')}</li>
          <li>{t('Plain files, at home in a git repo.', 'Archivos simples, cómodos en un repo git.')}</li>
          <li>{t('Open source, MIT license.', 'Código abierto, licencia MIT.')}</li>
        </ul>
      </div>
<pre class="bloque ancho" aria-label={t('Example of a note with a code block', 'Ejemplo de una nota con un bloque de código')}><code><span class="pr">##</span> {t('Deploy notes', 'Notas del deploy')}

<span class="pr">```sh</span>
<span class="pr">$</span> pnpm version patch
<span class="pr">$</span> git push --follow-tags
<span class="pr">```</span>

<span class="pr">-</span> [ ] {t('update the changelog', 'actualizar el changelog')}</code></pre>
    </div>
  </section>

  <section class="camara" id={t('smart', 'inteligente')} data-nombre={t('Simple, but smart', 'Simple, pero inteligente')}>
    <div class="hueco">
      <p class="etiqueta">{t('Simple, but smart', 'Simple, pero inteligente')}</p>
      <h2>{t('Details that stay out of the way', 'Detalles que no estorban')}</h2>
      <div class="tarjetas">
        <div class="tarjeta"><h3>{t('An outline that follows you', 'Un índice que te sigue')}</h3><p>{t('The heading you are under lights up.', 'El título donde escribes se ilumina.')}</p></div>
        <div class="tarjeta"><h3>{t('Pins', 'Fijados')}</h3><p>{t('Your project on top, like pinned tabs.', 'Tu proyecto arriba, como pestañas fijadas.')}</p></div>
        <div class="tarjeta"><h3>{t('An editor per chamber', 'Un editor por cámara')}</h3><p>{t('A writer’s, a programmer’s, or both.', 'De escritor, de programador o los dos.')}</p></div>
        <div class="tarjeta"><h3>{t('Notes that travel', 'Notas que viajan')}</h3><p>{t('Pins and options go with your notes.', 'Fijados y opciones van con tus notas.')}</p></div>
        <div class="tarjeta"><h3>{t('Nothing gets lost', 'Nada se pierde')}</h3><p>{t('Saves as you type, never overwrites.', 'Guarda sola y nunca pisa nada.')}</p></div>
        <div class="tarjeta"><h3>{t('Find and replace', 'Buscar y reemplazar')}</h3><p>{t('With regular expressions too.', 'También con expresiones regulares.')}</p></div>
      </div>
    </div>
  </section>

  <section class="camara" id={t('light', 'liviana')} data-nombre={t('Light', 'Liviana')}>
    <div class="hueco">
      <p class="etiqueta">{t('Light as an ant', 'Liviana como una hormiga')}</p>
      <h2>{t('About 5 MB', 'Unos 5 MB')}</h2>
      <p style="max-width: 50ch">{t('No bundled browser. It opens instantly.', 'Sin navegador incluido. Abre al instante.')}</p>
      <div class="sellos">
        <div><b>5.2 MB</b><span>{t('macOS installer', 'instalador macOS')}</span></div>
        <div><b>2.1 MB</b><span>{t('Windows installer', 'instalador Windows')}</span></div>
        <div><b>2.6 MB</b><span>{t('Linux .deb', '.deb de Linux')}</span></div>
      </div>
    </div>
  </section>

  <section class="camara" id={t('shortcuts', 'atajos')} data-nombre={t('Shortcuts', 'Atajos')}>
    <div class="hueco">
      <p class="etiqueta">{t('Hands on the keyboard', 'Con el teclado')}</p>
      <h2>{t('Shortcuts', 'Atajos')}</h2>
      <dl class="atajos dos">
        <dt><kbd>⌘</kbd> <kbd>N</kbd></dt><dd>{t('New note', 'Nueva nota')}</dd>
        <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>N</kbd></dt><dd>{t('New chamber', 'Cámara nueva')}</dd>
        <dt><kbd>⌘</kbd> <kbd>O</kbd></dt><dd>{t('Open', 'Abrir')}</dd>
        <dt><kbd>⌘</kbd> <kbd>S</kbd></dt><dd>{t('Save', 'Guardar')}</dd>
        <dt><kbd>⌘</kbd> <kbd>\</kbd></dt><dd>{t('Sidebar', 'Barra lateral')}</dd>
        <dt><kbd>⌘</kbd> <kbd>,</kbd></dt><dd>{t('Settings', 'Ajustes')}</dd>
        <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>E</kbd></dt><dd>{t('Compile and export', 'Compilar y exportar')}</dd>
        <dt><kbd>⌘</kbd> <kbd>F</kbd></dt><dd>{t('Find', 'Buscar')}</dd>
      </dl>
      <p class="tenue" style="margin-top: 18px">{t('All of them can be changed.', 'Todos se pueden cambiar.')}</p>
    </div>
  </section>

  <section class="camara pie" id={t('start', 'empezar')} data-nombre={t('Start writing', 'Empieza a escribir')}>
    <div class="hueco">
      <p class="etiqueta">{t('The end of the tunnel', 'El final del túnel')}</p>
      <h2>{t('Start writing', 'Empieza a escribir')}</h2>
      <p style="max-width: 46ch">{t('Free. Download it, dig your anthill and write.', 'Gratis. Descárgala, cava tu hormiguero y escribe.')}</p>
      <div class="acciones">
        <a class="boton lleno" href={instalar}>{t('Download', 'Descargar')}</a>
        <a class="boton" href={docs}>{t('Read the documentation', 'Leer la documentación')}</a>
        <a class="boton" href={sitio.repo}>{t('Code on GitHub', 'Código en GitHub')} ↗</a>
      </div>
      <p class="tenue" style="margin-top: 24px">{t('A project by', 'Un proyecto de')} <a href={sitio.portafolio}>{sitio.autor}</a>. {t('Free and open source,', 'Gratis y de código abierto,')} <a href={sitio.licencia}>{t('MIT license', 'licencia MIT')}</a>.<br />{t('Inspired by', 'Inspirada en')} <a href={sitio.left}>Left</a>{t(', the plain-text editor by', ', el editor de texto plano de')} <a href={sitio.hundredRabbits}>Hundred Rabbits</a>{t('. Thank you!', '. ¡Gracias!')}</p>
    </div>
  </section>

</Nido>
