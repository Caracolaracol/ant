---
// Documentación de Ant en inglés o español. A diferencia de la portada, se lee de arriba hacia
// abajo: es una sola cámara gigante (pegada a los bordes de la ventana) con un índice fijo a la
// izquierda y un tema tras otro, separados por un rastro de hormigas. Cada tema tiene un `id`
// para enlazarlo directo (por ejemplo /documentation/#shortcuts) y un `data-nombre` para el
// recorrido de abajo.
import Nido from '../layouts/Nido.astro';
import { sitio, traductor, type Idioma } from '../lib/sitio';

interface Props { idioma: Idioma; }
const { idioma } = Astro.props;
const t = traductor(idioma);

// Temas en orden: id (en el idioma de la página) y nombre para el índice.
const temas = [
  { id: t('install', 'instalar'), nombre: t('Download', 'Descargar') },
  { id: t('getting-started', 'primeros-pasos'), nombre: t('Getting started', 'Primeros pasos') },
  { id: t('writing', 'escribir'), nombre: t('Writing and saving', 'Escribir y guardar') },
  { id: t('sidebar', 'barra-lateral'), nombre: t('Sidebar', 'Barra lateral') },
  { id: t('pins', 'fijados'), nombre: t('Pins', 'Fijados') },
  { id: t('search', 'buscar'), nombre: t('Find and replace', 'Buscar y reemplazar') },
  { id: t('export', 'exportar'), nombre: t('Compile and export', 'Compilar y exportar') },
  { id: t('shortcuts', 'atajos'), nombre: t('Shortcuts', 'Atajos') },
  { id: t('settings', 'ajustes'), nombre: t('Settings', 'Ajustes') },
  { id: t('development', 'desarrollo'), nombre: t('Development', 'Desarrollo') },
  { id: t('icon', 'icono'), nombre: t('Icon', 'Icono') },
];
const [instalar, primeros, escribir, lateral, fijados, buscar, exportar, atajos, ajustes, desarrollo, icono] = temas;
---
<Nido
  idioma={idioma}
  seccion="docs"
  modo="vertical"
  titulo={t('Documentation · Ant', 'Documentación · Ant')}
  descripcion={t(
    'How to install and use Ant: the anthill and its chambers, pins, shortcuts, settings, and how to build it from source.',
    'Cómo instalar y usar Ant: el hormiguero y sus cámaras, fijados, atajos, ajustes y cómo compilarla desde el código.',
  )}
>
  <div class="hueco gigante">
    <nav class="gigante-indice" aria-label={t('Contents', 'Contenido')}>
      <p class="etiqueta">{t('Contents', 'Contenido')}</p>
      <ol>
        {temas.map((tema) => <li><a href={`#${tema.id}`}>{tema.nombre}</a></li>)}
      </ol>
    </nav>

    <article>
      <header class="gigante-titulo">
        <p class="etiqueta">{t('Documentation', 'Documentación')}</p>
        <h1>{t('Inside the nest', 'Dentro del nido')}</h1>
        <p class="lema">{t('Everything Ant does, one chamber at a time.', 'Todo lo que hace Ant, cámara por cámara.')}</p>
        {idioma === 'en' && <p class="tenue">Ant’s interface is in Spanish for now. Menu and button names appear here as they show up in the app, with their meaning in parentheses.</p>}
      </header>

      <section class="tema" id={instalar.id} data-nombre={instalar.nombre}>
        <p class="etiqueta">01</p>
        <h2>{t('Download Ant', 'Descargar Ant')}</h2>
        <p>{t('Get the latest version from', 'Baja la última versión desde')} <a href={sitio.descargas}>GitHub Releases</a>:</p>
        <ul>
          <li><strong>macOS</strong>: <code>Ant_x.y.z_universal.dmg</code> {t('(Apple Silicon and Intel). Open it and drag Ant to Applications.', '(Apple Silicon e Intel). Ábrelo y arrastra Ant a Aplicaciones.')}</li>
          <li><strong>Windows</strong>: <code>Ant_x.y.z_x64-setup.exe</code> {t('or the', 'o el')} <code>.msi</code>.</li>
          <li><strong>Linux</strong>: <code>.AppImage</code>, <code>.deb</code> {t('(Debian, Ubuntu) or', '(Debian, Ubuntu) o')} <code>.rpm</code> {t('(Fedora).', '(Fedora).')}</li>
        </ul>
        <p class="tenue">{t(
          'Ant is not signed by Apple or Microsoft, so the first time the system warns you. On macOS: try to open it, then go to System Settings → Privacy & Security → Open Anyway. On Windows: More info → Run anyway. On Windows and Linux shortcuts use Ctrl where this guide says Cmd.',
          'Ant no está firmada por Apple ni por Microsoft, así que la primera vez el sistema avisa. En macOS: intenta abrirla y luego ve a Ajustes del Sistema → Privacidad y seguridad → Abrir igualmente. En Windows: Más información → Ejecutar de todas formas. En Windows y Linux los atajos usan Ctrl donde esta guía dice Cmd.',
        )}</p>
        <p>{t('Every change is listed in the', 'Cada cambio queda anotado en el')} <a href={sitio.changelog}>CHANGELOG</a>.</p>

        <h3>{t('Build it from source', 'Compilarla desde el código')}</h3>
        <p>{t('You need:', 'Necesitas:')}</p>
        <ul>
          <li><a href="https://www.rust-lang.org/tools/install">Rust</a> {t('(stable)', 'estable')}</li>
          <li>{t('Node.js 22 or newer and', 'Node.js 22 o superior y')} <a href="https://pnpm.io/installation">pnpm</a></li>
        </ul>
<pre><code><span class="pr">$ </span>git clone {sitio.repo}.git
<span class="pr">$ </span>cd ant
<span class="pr">$ </span>pnpm install
<span class="pr">$ </span>pnpm tauri build</code></pre>
        <p>{t('The installers end up in', 'Los instaladores quedan en')} <code>src-tauri/target/release/bundle/</code> {t('(on Mac, also', '(en Mac, también')} <code>macos/Ant.app</code>). {t('Tauri builds for the system you run it on: Windows on Windows, Linux on Linux.', 'Tauri compila para el sistema donde lo corres: Windows en Windows, Linux en Linux.')}</p>
      </section>

      <section class="tema" id={primeros.id} data-nombre={primeros.nombre}>
        <p class="etiqueta">02</p>
        <h2>{t('Your anthill and its chambers', 'Tu hormiguero y sus cámaras')}</h2>
        <p>{t(
          'Ant keeps all your notes in one anthill: a folder on your computer, new or one you already have, such as your Obsidian vault. Inside it, each chamber is a folder for one context of your life: your personal notes, everything about one novel, your work as a developer and its projects. The sidebar shows one chamber at a time.',
          'Ant guarda todas tus notas en un hormiguero: una carpeta de tu computador, nueva o una que ya tengas, como tu bóveda de Obsidian. Dentro, cada cámara es una carpeta para un contexto de tu vida: tus notas personales, todo lo de una novela, tu trabajo de desarrollador y sus proyectos. La barra lateral muestra una cámara a la vez.',
        )}</p>
        <ol>
          <li>{t('The first time you open Ant, a short welcome takes you through the tunnel.', 'La primera vez que abres Ant, una bienvenida corta te lleva por el túnel.')}</li>
          <li>{t('In its third chamber, choose your anthill: give it a name and click', 'En su tercera cámara, elige tu hormiguero: ponle un nombre y pulsa')} <b>{t('Dig the anthill', 'Cavar el hormiguero')}</b> {t('(Ant creates the folder, in Documents unless you choose another place), or click', '(Ant crea la carpeta, en Documentos salvo que elijas otro lugar), o pulsa')} <b>{t('Use a folder you already have…', 'Usar una carpeta que ya tengo…')}</b>.</li>
          <li>{t('In the last one, dig your first chamber (or open one of the folders the anthill already has). The sidebar shows it right away.', 'En la última, cava tu primera cámara (o abre una de las carpetas que el hormiguero ya tiene). La barra lateral la muestra al instante.')}</li>
        </ol>
        <h3>{t('More chambers', 'Más cámaras')}</h3>
        <ul>
          <li>{t('Dig as many as you want with the folder button at the top of the window, next to the window buttons, with', 'Cava todas las que quieras con el botón de la carpeta arriba de la ventana, junto a los botones de la ventana, con')} <b>{t('File → New Chamber…', 'Archivo → Cámara nueva…')}</b> {t('or with', 'o con')} <kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>N</kbd>.</li>
          <li>{t('To switch chambers, click the name of the open one at the top of the sidebar: the list of chambers unfolds. You also see them all in', 'Para cambiar de cámara, haz clic en el nombre de la abierta arriba de la barra lateral: se despliega la lista de cámaras. También las ves todas en')} <b>{t('Settings → General', 'Ajustes → General')}</b>{t('. Every top-level folder of the anthill is a chamber, so a folder you create in Finder shows up there too.', '. Cada carpeta de primer nivel del hormiguero es una cámara, así que una carpeta que crees en Finder también aparece ahí.')}</li>
          <li>{t('Loose notes at the root of the anthill are the', 'Las notas sueltas en la raíz del hormiguero son la')} <b>{t('Entrance', 'Entrada')}</b>{t(', the first chamber in the list. It only shows up while there are loose notes, and it has no diary.', ', la primera cámara de la lista. Solo aparece mientras haya notas sueltas, y no tiene diario.')}</li>
          <li>{t('There you can also change the anthill for another folder; nothing is moved or deleted.', 'Ahí también puedes cambiar el hormiguero por otra carpeta; nada se mueve ni se borra.')}</li>
          <li>{t('The welcome can be seen again from', 'La bienvenida se puede ver de nuevo desde')} <b>{t('Ant → Welcome to Ant…', 'Ant → Bienvenida a Ant…')}</b>.</li>
        </ul>
        <h3>{t('What it shows', 'Qué muestra')}</h3>
        <ul>
          <li>{t('Notes ending in', 'Notas')} <code>.md</code>, <code>.markdown</code> {t('and', 'y')} <code>.txt</code>{t(', with their subfolders.', ', con sus subcarpetas.')}</li>
          <li>{t('Hidden folders,', 'Se saltan las carpetas ocultas,')} <code>node_modules</code>, <code>target</code> {t('and folders without notes are skipped.', 'y las carpetas sin notas.')}</li>
          <li>{t('It is read again when you save and every time you come back to the window, in case you moved something from Finder or another app.', 'Se vuelve a leer al guardar y cada vez que vuelves a la ventana, por si moviste algo desde Finder u otra app.')}</li>
        </ul>
        <p class="tenue">{t('Notes outside the anthill open too: use', 'También se abren notas fuera del hormiguero: usa')} <kbd>⌘</kbd> <kbd>O</kbd>.</p>
      </section>

      <section class="tema" id={escribir.id} data-nombre={escribir.nombre}>
        <p class="etiqueta">03</p>
        <h2>{t('Plain text, as you write it', 'Texto plano, tal cual')}</h2>
        <p>{t(
          'Notes are saved exactly as you type them, in Markdown. Ant colors headings, emphasis, links and code blocks, but never changes the file.',
          'Las notas se guardan exactamente como las escribes, en Markdown. Ant colorea los títulos, el énfasis, los enlaces y los bloques de código, pero nunca cambia el archivo.',
        )}</p>
        <ul>
          <li><kbd>⌘</kbd> <kbd>N</kbd> {t('or the pencil button at the top of the window creates a new note: give it a name (or keep “Untitled”) and press Enter. It is created next to the note you are reading, or in the chamber, and Ant saves it for you from the first word. It never overwrites a note with the same name.', 'o el botón del lápiz arriba de la ventana crea una nota nueva: ponle nombre (o deja «Sin título») y pulsa Enter. Se crea junto a la nota que estás leyendo, o en la cámara, y Ant la guarda sola desde la primera palabra. Nunca pisa una nota con el mismo nombre.')}</li>
          <li><kbd>⌘</kbd> <kbd>S</kbd> {t('saves right away (Ant already saves on its own).', 'guarda al instante (Ant ya guarda sola).')}</li>
          <li><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>S</kbd> {t('saves it under another name.', 'la guarda con otro nombre.')}</li>
        </ul>
        <div class="columnas">
          <div>
            <h3>{t('Automatic saving', 'Guardado automático')}</h3>
            <p>{t('Ant saves your note a moment after you stop typing, and also when you open another note, leave the window or quit. There is nothing to remember. Only a new note that was never saved is marked with', 'Ant guarda tu nota un momento después de que dejas de escribir, y también al abrir otra nota, salir de la ventana o cerrar la app. No hay nada que recordar. Solo una nota nueva que nunca se guardó se marca con')} <code>*</code>{t(', and Ant asks before discarding it.', ', y Ant pregunta antes de descartarla.')}</p>
            <p class="tenue">{t('If a note changes outside Ant (in Obsidian, or through a sync service), Ant shows the new text when you come back. If it also changed in Ant, Ant does not overwrite the file: it warns you at the bottom, and', 'Si una nota cambia fuera de Ant (en Obsidian, o por una sincronización), Ant muestra el texto nuevo al volver. Si también cambió en Ant, Ant no sobrescribe el archivo: avisa abajo, y')} <kbd>⌘</kbd> <kbd>S</kbd> {t('keeps your version.', 'se queda con tu versión.')}</p>
          </div>
          <div>
            <h3>{t('Status bar', 'Barra de estado')}</h3>
            <p>{t('At the bottom: the note’s name and its word, line and character count. Errors show up there too, for example when a folder cannot be written.', 'Abajo: el nombre de la nota y el conteo de palabras, líneas y caracteres. Ahí también aparecen los errores, por ejemplo si falta permiso para escribir.')}</p>
          </div>
          <div>
            <h3>{t('Safe saves', 'Guardado seguro')}</h3>
            <p>{t('Ant first writes a temporary file and then renames it over the note, so a file is never left half-written.', 'Ant escribe primero un archivo temporal y después lo renombra sobre la nota, así nunca queda un archivo a medio escribir.')}</p>
          </div>
        </div>
      </section>

      <section class="tema" id={lateral.id} data-nombre={lateral.nombre}>
        <p class="etiqueta">04</p>
        <h2>{t('From top to bottom', 'De arriba hacia abajo')}</h2>
        <p>{t('At the very top, next to the window buttons, three small icons: hide or show the sidebar, new note and new chamber. Hover over one to see its name and shortcut.', 'Arriba de todo, junto a los botones de la ventana, tres iconos chicos: ocultar o mostrar la barra lateral, nota nueva y cámara nueva. Al pasar el mouse se ve su nombre y su atajo.')}</p>
        <ol>
          <li><b>{t('The chamber', 'La cámara')}</b>{t(': the name of the open chamber. Click it to switch to another or dig a new one.', ': el nombre de la cámara abierta. Haz clic para pasar a otra o cavar una nueva.')}</li>
          <li><b>{t('Pinned', 'Fijados')}</b>{t(': a row of icons with what you pinned (see the next section).', ': una fila de iconos con lo que fijaste (ver la siguiente sección).')}</li>
          <li><b>{t('Open', 'Abiertas')}</b>{t(': open notes that are not in the chamber, such as a new unsaved one.', ': notas abiertas que no están en la cámara, como una nueva sin guardar.')}</li>
          <li><b>{t('Its notes', 'Sus notas')}</b>{t(': the tree of the chamber’s subfolders and notes. Folders fold and unfold with a click.', ': el árbol de subcarpetas y notas de la cámara. Las carpetas se pliegan con un clic.')}</li>
        </ol>
        <p><kbd>⌘</kbd> <kbd>\</kbd> {t('shows or hides it. To make it wider or narrower, drag its right edge: the pointer changes to ↔ when you are over it. Double-click the edge to go back to the default width.', 'la muestra u oculta. Para ensancharla o achicarla, arrastra su borde derecho: el puntero cambia a ↔ al pasar por encima. Doble clic en el borde la deja con el ancho de siempre.')}</p>
        <div class="columnas">
          <div>
            <h3>{t('The note’s headings', 'Títulos de la nota')}</h3>
            <p>{t('Under the open note you see its headings (', 'Bajo la nota abierta aparecen sus títulos (')}<code>#</code> {t('to', 'a')} <code>######</code>{t('), indented by level. Click one to move the cursor there. The heading you are writing under is highlighted.', '), con sangría según el nivel. Un clic lleva el cursor a ese título. El título bajo el que estás escribiendo se resalta.')}</p>
            <p class="tenue"><code>#</code> {t('inside code blocks does not count as a heading.', 'dentro de bloques de código no cuenta como título.')}</p>
          </div>
          <div>
            <h3>{t('One note at a time', 'Una nota a la vez')}</h3>
            <p>{t('Opening a note replaces the one you had open, which is saved first. Only new notes that were never saved stay open, under', 'Abrir una nota reemplaza la que tenías abierta, que antes se guarda. Solo las notas nuevas que nunca se guardaron siguen abiertas, bajo')} <b>{t('Open', 'Abiertas')}</b>{t('; switch between them with', '; pasa de una a otra con')} <kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>]</kbd> {t('and', 'y')} <kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>[</kbd>.</p>
          </div>
        </div>
      </section>

      <section class="tema" id={fijados.id} data-nombre={fijados.nombre}>
        <p class="etiqueta">05</p>
        <h2>{t('What you use most, on top', 'Lo que más usas, arriba')}</h2>
        <p>{t('Like pinned tabs in Zen or Arc: right-click a folder or note in the tree, or a heading under the open note →', 'Como las pestañas fijadas de Zen o Arc: clic derecho sobre una carpeta o nota del árbol, o sobre un título bajo la nota abierta →')} <b>{t('Pin to top', 'Fijar arriba')}</b>{t('. It becomes an icon at the top of the sidebar; hover it to see its name.', '. Pasa a ser un icono arriba de la barra lateral; pasa el mouse por encima para ver su nombre.')}</p>
        <ul>
          <li>{t('A pinned note opens with a click. A pinned folder unfolds below the icons. A pinned heading (a chapter) opens its note right there.', 'Una nota fijada se abre con un clic. Una carpeta fijada se despliega bajo los iconos. Un título fijado (un capítulo) abre su nota justo ahí.')}</li>
          <li>{t('Each one starts with the icon of its kind. To choose another: right-click →', 'Cada uno empieza con el icono de su tipo. Para elegir otro: clic derecho →')} <b>{t('Change icon…', 'Cambiar icono…')}</b> {t('(about a hundred, from', '(cerca de cien, de')} <a href="https://lucide.dev">Lucide</a>).</li>
          <li>{t('To unpin it: right-click →', 'Para soltarlo: clic derecho →')} <b>{t('Unpin', 'Quitar de fijados')}</b>.</li>
          <li>{t('Each chamber has its own pins: when you switch chambers, you see that chamber’s pins. They are saved inside the anthill, in', 'Cada cámara tiene sus propios fijados: si cambias de cámara, ves los de esa. Se guardan dentro del hormiguero, en')} <code>.ant/</code>{t(', so they travel with your notes.', ', así viajan con tus notas.')}</li>
          <li>{t('If something pinned is deleted or moved outside Ant, its icon stays, dimmed, until you remove it.', 'Si borras o mueves algo fijado fuera de Ant, su icono queda atenuado hasta que lo quites.')}</li>
        </ul>
      </section>

      <section class="tema" id={buscar.id} data-nombre={buscar.nombre}>
        <p class="etiqueta">06</p>
        <h2>{t('Inside the note', 'Dentro de la nota')}</h2>
        <p><kbd>⌘</kbd> <kbd>F</kbd> {t('opens the search panel below the editor. From there you can:', 'abre el panel de búsqueda abajo del editor. Desde ahí puedes:')}</p>
        <ul>
          <li>{t('go to the next or previous match', 'ir a la coincidencia siguiente o anterior')} (<kbd>Enter</kbd> / <kbd>⇧</kbd> <kbd>Enter</kbd>);</li>
          <li>{t('match case, search whole words or use regular expressions;', 'distinguir mayúsculas, buscar palabras completas o usar expresiones regulares;')}</li>
          <li>{t('replace one match or all of them.', 'reemplazar una coincidencia o todas.')}</li>
        </ul>
        <p class="tenue">{t('When you select a word, its other appearances on screen are highlighted.', 'Al seleccionar una palabra, sus otras apariciones en pantalla se resaltan.')}</p>
      </section>

      <section class="tema" id={exportar.id} data-nombre={exportar.nombre}>
        <p class="etiqueta">07</p>
        <h2>{t('From notes to a book', 'De notas a libro')}</h2>
        <p>{t('A novel is many notes: one per chapter. ', 'Una novela son muchas notas: una por capítulo. ')}<b>{t('File → Compile and Export…', 'Archivo → Compilar y exportar…')}</b> (<kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>E</kbd>) {t('joins the notes of a folder into a single document, in Word or PDF.', 'une las notas de una carpeta en un solo documento, en Word o PDF.')}</p>
        <ol>
          <li>{t('Choose the folder. Each note is a chapter: uncheck the ones you leave out (research, drafts) and use the arrows to change the order.', 'Elige la carpeta. Cada nota es un capítulo: desmarca las que quedan fuera (investigación, borradores) y usa las flechas para cambiar el orden.')}</li>
          <li>{t('Write the title and the author, and choose the format and the style.', 'Escribe el título y el autor, y elige el formato y el estilo.')}</li>
          <li>{t('Export. Ant remembers everything for that folder, so the next time it is a single click.', 'Exporta. Ant recuerda todo para esa carpeta, así la próxima vez es un clic.')}</li>
        </ol>
        <div class="columnas">
          <div>
            <h3>{t('Standard manuscript', 'Manuscrito estándar')}</h3>
            <p>{t('What publishers, agents and contests ask for: Times 12, double spaced, one-inch margins, indented paragraphs, a header with your surname, the title and the page number, a title page with the word count and each chapter on a new page.', 'El que piden editoriales, agentes y concursos: Times 12, doble espacio, márgenes de 2,5 cm, párrafos con sangría, encabezado con tu apellido, el título y la página, portada con el conteo de palabras y cada capítulo en página nueva.')}</p>
          </div>
          <div>
            <h3>{t('Book', 'Libro')}</h3>
            <p>{t('To read or print: A5 page, justified text, the first paragraph of each chapter and scene without indent, and page numbers at the foot.', 'Para leer o imprimir: página A5, texto justificado, el primer párrafo de cada capítulo y escena sin sangría, y número de página al pie.')}</p>
          </div>
        </div>
        <h3>{t('How your notes become a book', 'Cómo tus notas se vuelven libro')}</h3>
        <ul>
          <li>{t('The chapter title is the note’s first heading (', 'El título del capítulo es el primer título de la nota (')}<code># …</code>{t('), or the file name without its numbering («01 - The nest» → «The nest»).', '), o el nombre del archivo sin su numeración («01 - El hormiguero» → «El hormiguero»).')}</li>
          <li>{t('Each line is a paragraph.', 'Cada línea es un párrafo.')} <code>***</code>, <code>---</code> {t('or', 'o')} <code>#</code> {t('alone on a line mark a scene break.', 'solos en una línea marcan un cambio de escena.')}</li>
          <li>{t('Text between', 'El texto entre')} <code>%%</code> {t('and', 'y')} <code>%%</code> {t('(notes to yourself) and the YAML header are not exported.', '(notas para ti) y el encabezado YAML no se exportan.')}</li>
          <li>{t('Optionally, the typography of the whole text is fixed (quotes, dashes, ellipses), without touching your files.', 'Si quieres, se corrige la tipografía de todo el texto (comillas, rayas, puntos suspensivos), sin tocar tus archivos.')}</li>
        </ul>
        <p class="tenue">{t('The PDF uses the Times fonts built into every PDF reader, which cover the Latin alphabet (accents, ñ, « », dashes); other alphabets are not supported yet.', 'El PDF usa las fuentes Times que trae todo lector de PDF, que cubren el alfabeto latino (tildes, ñ, « », rayas); otros alfabetos todavía no.')}</p>
      </section>

      <section class="tema" id={atajos.id} data-nombre={atajos.nombre}>
        <p class="etiqueta">08</p>
        <h2>{t('All shortcuts', 'Todos los atajos')}</h2>
        <dl class="atajos dos">
          <dt><kbd>⌘</kbd> <kbd>N</kbd></dt><dd>{t('New note', 'Nueva nota')}</dd>
          <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>N</kbd></dt><dd>{t('New chamber', 'Cámara nueva')}</dd>
          <dt><kbd>⌘</kbd> <kbd>O</kbd></dt><dd>{t('Open note', 'Abrir nota')}</dd>
          <dt><kbd>⌘</kbd> <kbd>S</kbd></dt><dd>{t('Save', 'Guardar')}</dd>
          <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>S</kbd></dt><dd>{t('Save as', 'Guardar como')}</dd>
          <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>]</kbd></dt><dd>{t('Next note', 'Nota siguiente')}</dd>
          <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>[</kbd></dt><dd>{t('Previous note', 'Nota anterior')}</dd>
          <dt><kbd>⌘</kbd> <kbd>\</kbd></dt><dd>{t('Show or hide the sidebar', 'Mostrar u ocultar la barra')}</dd>
          <dt><kbd>⌘</kbd> <kbd>,</kbd></dt><dd>{t('Settings', 'Ajustes')}</dd>
          <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>E</kbd></dt><dd>{t('Compile and export', 'Compilar y exportar')}</dd>
          <dt><kbd>⌘</kbd> <kbd>F</kbd></dt><dd>{t('Find and replace', 'Buscar y reemplazar')}</dd>
          <dt><kbd>⌘</kbd> <kbd>Z</kbd></dt><dd>{t('Undo', 'Deshacer')}</dd>
          <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>Z</kbd></dt><dd>{t('Redo', 'Rehacer')}</dd>
          <dt><kbd>Tab</kbd></dt><dd>{t('Indent line', 'Sangrar línea')}</dd>
        </dl>
        <p class="tenue" style="margin-top: 18px">{t('On Windows and Linux,', 'En Windows y Linux,')} <kbd>⌘</kbd> {t('is', 'es')} <kbd>Ctrl</kbd>. <kbd>⌘</kbd> <kbd>W</kbd> {t('does not close the main window, so you cannot lose it by accident.', 'no cierra la ventana principal, para no perderla por accidente.')}</p>
      </section>

      <section class="tema" id={ajustes.id} data-nombre={ajustes.nombre}>
        <p class="etiqueta">09</p>
        <h2>{t('Right over your notes', 'Sobre tus notas')}</h2>
        <p><kbd>⌘</kbd> <kbd>,</kbd> {t('opens Settings over the main window: areas on the left and their options on the right. Changes apply right away, with no save button.', 'abre los Ajustes sobre la ventana principal: las áreas a la izquierda y sus opciones a la derecha. Los cambios se aplican al instante, sin botón de guardar.')} <kbd>Esc</kbd>, <kbd>⌘</kbd> <kbd>W</kbd> {t('or a click outside closes them.', 'o un clic fuera los cierra.')}</p>
        <ul>
          <li><b>General</b>{t(': the language (English by default, or Spanish), your anthill (you can change it for another folder) and its chambers: open one or dig a new one.', ': el idioma (inglés por defecto, o español), tu hormiguero (puedes cambiarlo por otra carpeta) y sus cámaras: abrir una o cavar una nueva.')}</li>
          <li><b>Editor</b>{t(': at the top, ', ': arriba de todo, el ')}<b>{t('Writer mode', 'Modo escritor')}</b>{t(', on by default. It adapts the editor to prose: smart quotes (“ ” or « », depending on the language) and', ', activado por defecto. Adapta el editor a la prosa: comillas tipográficas (“ ” o « », según el idioma) y')} <code>--</code> → <code>—</code>, <code>...</code> → <code>…</code>, <code>&lt;&lt; &gt;&gt;</code> → <code>« »</code>, <code>-&gt;</code> → <code>→</code> {t('as you type (Backspace right after undoes the change; nothing changes inside code), a serif book font in a narrower column, and spell checking. Each part can be turned off.', 'al escribir (Backspace justo después deshace el cambio; nada cambia dentro del código), letra de libro con serifa en una columna más angosta y corrector ortográfico. Cada parte se puede apagar.')}</li>
          <li><b>{t('Diary', 'Diario')}</b>{t(': shows a calendar at the top of the sidebar. Click a day to open its note,', ': muestra un calendario arriba de la barra lateral. Al hacer clic en un día se abre su nota,')} <code>Daily/2026-11-20.md</code>{t(', inside the open chamber. If the note or the Daily folder do not exist yet, Ant creates them; if the chamber already has a Daily folder, Ant uses it. Days that already have a note show a dot. In this mode the Daily folder is hidden from the tree: you reach daily notes through the calendar, and the open ones are listed below it.', ', dentro de la cámara abierta. Si la nota o la carpeta Daily aún no existen, Ant las crea; si la cámara ya tiene una carpeta Daily, Ant usa esa. Los días que ya tienen nota llevan un punto. En este modo la carpeta Daily no aparece en el árbol: a las notas diarias se llega desde el calendario, y las abiertas se listan bajo él.')}</li>
          <li><b>{t('Appearance', 'Apariencia')}</b>{t(': ready-made themes (Ant, the default one, Dark, Night, Paper, Sepia) and every color one by one.', ': temas listos (Ant, el de por defecto, Oscuro, Noche, Papel, Sepia) y cada color por separado.')}</li>
        </ul>
        <h3>{t('Where they are stored', 'Dónde se guardan')}</h3>
        <p>{t('What belongs to this computer (language, colors, where your anthill is) goes in a JSON file, in the app’s configuration folder:', 'Lo que es de este computador (idioma, colores, dónde está tu hormiguero) va en un archivo JSON, en la carpeta de configuración de la app:')}</p>
<pre><code>~/Library/Application Support/cl.agus.ant/ajustes.json</code></pre>
<pre><code>{"{"}
  "hormiguero": "{t('/Users/you/Documents/Anthill', '/Users/tu/Documents/Hormiguero')}",
  "camara_abierta": "{t('Novel', 'Novela')}",
  "modo_diario": true,
  "colores_elegidos": {"{"} "acento": "#e5ea15" {"}"},
  "idioma": "{t('en', 'es')}",
  "modo_escritor": true
{"}"}</code></pre>
        <p class="tenue">{t('On Windows it lives in', 'En Windows queda en')} <code>%APPDATA%\cl.agus.ant\</code> {t('and on Linux in', 'y en Linux en')} <code>~/.config/cl.agus.ant/</code>.</p>
        <p>{t('What belongs to your notes goes inside the anthill, in a hidden', 'Lo que es de tus notas va dentro del hormiguero, en una carpeta oculta')} <code>.ant/</code> {t('folder (like', '(como')} <code>.obsidian/</code> {t('in a vault), with one file per chamber: its pins, their icons and the Compile and Export options. So they travel with your notes when you move, sync or back up the anthill. Paths inside are relative to the chamber.', 'en una bóveda), con un archivo por cámara: sus fijados, sus iconos y las opciones de Compilar y exportar. Así viajan con tus notas al mover, sincronizar o respaldar el hormiguero. Las rutas de adentro son relativas a la cámara.')}</p>
<pre><code>{t('Anthill', 'Hormiguero')}/.ant/camaras/{t('Novel', 'Novela')}.json
{"{"}
  "version": 1,
  "fijados": ["{t('Book I', 'Libro I')}", "{t('Book I/01 - The anthill.md#The rain', 'Libro I/01 - El hormiguero.md#La lluvia')}"],
  "iconos_de_fijados": {"{"} "{t('Book I', 'Libro I')}": "book-open" {"}"},
  "opciones_de_compilacion_por_carpeta": {"{"} {"}"}
{"}"}</code></pre>
        <p class="tenue">{t('The Entrance (loose notes at the root) uses', 'La Entrada (las notas sueltas de la raíz) usa')} <code>.ant/camaras/.entrada.json</code>. {t('If you rename a chamber’s folder outside Ant, rename its file in', 'Si renombras la carpeta de una cámara fuera de Ant, renombra también su archivo en')} <code>.ant/camaras/</code> {t('too, to keep its pins.', 'para conservar sus fijados.')}</p>
      </section>

      <section class="tema" id={desarrollo.id} data-nombre={desarrollo.nombre}>
        <p class="etiqueta">10</p>
        <h2>{t('How it is built', 'Cómo está hecha')}</h2>
        <ul>
          <li><b>Tauri 2</b> {t('(Rust,', '(Rust,')} <code>src-tauri/</code>){t(': the window, the menus, reading and writing notes, listing the folder and the settings.', ': la ventana, los menús, leer y escribir notas, listar la carpeta y los ajustes.')}</li>
          <li><b>React + TypeScript + Vite</b> (<code>src/</code>){t(': the welcome, the sidebar, the status bar, Settings and the dialogs.', ': la bienvenida, la barra lateral, la barra de estado, los Ajustes y los diálogos.')}</li>
          <li><b>CodeMirror 6</b> (<code>src/editor/</code>){t(': the editor. A single view for every note; each note keeps its own state.', ': el editor. Una sola vista para todas las notas; cada una guarda su propio estado.')}</li>
        </ul>
        <p class="tenue">{t('The idea comes from', 'La idea viene de')} <a href={sitio.left}>Left</a>{t(', by', ', de')} <a href={sitio.hundredRabbits}>Hundred Rabbits</a>{t(': one window, the text and a sidebar with the document’s headings. Ant is written from scratch and shares no code with it.', ': una ventana, el texto y una barra lateral con los títulos del documento. Ant está escrita desde cero y no comparte código con Left.')}</p>
        <h3>{t('Commands', 'Comandos')}</h3>
<pre><code><span class="pr">$ </span>pnpm tauri dev    <span class="pr"># {t('app with hot reload', 'app con recarga en caliente')}</span>
<span class="pr">$ </span>pnpm build        <span class="pr"># {t('type-check and build the interface', 'revisa tipos y compila la interfaz')}</span>
<span class="pr">$ </span>cd src-tauri && cargo check
<span class="pr">$ </span>pnpm tauri build  <span class="pr"># {t('final .app and .dmg', '.app y .dmg finales')}</span></code></pre>
        <div class="columnas">
          <div>
            <h3>{t('CodeMirror patch', 'Parche de CodeMirror')}</h3>
            <p>{t('When selecting by dragging to the edge, CodeMirror scrolled in jumps every 50 ms. The patch in', 'Al seleccionar arrastrando hasta el borde, CodeMirror desplazaba el texto a saltos cada 50 ms. El parche en')} <code>patches/</code> {t('makes it move on every frame, and faster. pnpm applies it on install.', 'hace que avance en cada cuadro de pantalla, y más rápido. pnpm lo aplica al instalar.')}</p>
          </div>
          <div>
            <h3>{t('Conventions', 'Convenciones')}</h3>
            <p><code>AGENTS.md</code> {t('describes every file and the project’s conventions. Code comments are written in Spanish, one on top of every file and function.', 'describe cada archivo y las convenciones del proyecto. Los comentarios del código van en español, uno al inicio de cada archivo y función.')}</p>
          </div>
        </div>
      </section>

      <section class="tema" id={icono.id} data-nombre={icono.nombre}>
        <p class="etiqueta">11</p>
        <h2>{t('The ant’s face', 'La cara de la hormiga')}</h2>
        <p>{t('Flat and one color: bent antennae, eyes and mandibles, in yellow', 'Plano y de un color: antenas acodadas, ojos y mandíbulas, en amarillo')} <code>#e5ea15</code> {t('on', 'sobre')} <code>#1d1d20</code>. {t('The source is', 'La fuente es')} <code>marca/ant-icono.svg</code>{t('; this site copies it when it is built.', '; este sitio la copia al compilar.')}</p>
<pre><code><span class="pr">$ </span>swift marca/generar-icono.swift \
    marca/ant-icono.svg marca/ant-icono-1024.png
<span class="pr">$ </span>pnpm tauri icon marca/ant-icono-1024.png
<span class="pr">$ </span>rm -rf src-tauri/icons/android src-tauri/icons/ios</code></pre>
        <h3>{t('License', 'Licencia')}</h3>
        <p>{t('Ant is open source under the', 'Ant es de código abierto, con')} <a href={sitio.licencia}>{t('MIT license', 'licencia MIT')}</a>{t(': you can use, copy, modify and share it freely, keeping the copyright notice.', ': puedes usarla, copiarla, modificarla y compartirla libremente, manteniendo el aviso de copyright.')}</p>
        <p class="tenue">{t('Something unclear?', '¿Algo no está claro?')} <a href={`${sitio.repo}/issues`}>{t('Open an issue on GitHub ↗', 'Abre un issue en GitHub ↗')}</a></p>
      </section>
    </article>
  </div>
</Nido>
