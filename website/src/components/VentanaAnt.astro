---
// Maqueta de la ventana de Ant hecha con HTML y CSS (no es una captura): barra lateral con los
// fijados (iconos de Lucide, como en la app), la cámara abierta y los capítulos de la nota, editor con el borrador de un cuento en Markdown y barra de estado. Muestra la app
// pensada para escribir, en el idioma de la página.
import { traductor, type Idioma } from '../lib/sitio';
interface Props { idioma: Idioma; }
const t = traductor(Astro.props.idioma);
---
<figure class="ventana" aria-label={t('What Ant looks like: the sidebar on the left and the text on the right', 'Así se ve Ant: la barra lateral a la izquierda y el texto a la derecha')}>
  <div class="ventana-barra-titulo" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="ventana-cuerpo" aria-hidden="true">
    <div class="ventana-lateral">
      <div class="lat-fijados">
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" /><path d="M9 18h6" /><path d="M10 22h4" /></svg></i>
        <i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4" /><path d="M2 6h4" /><path d="M2 10h4" /><path d="M2 14h4" /><path d="M2 18h4" /><path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" /></svg></i>
        <i class="actual"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z" /></svg></i>
      </div>
      <p class="lat-carpeta">{t('writing', 'escritos')}</p>
      <p>▾ {t('novel', 'novela')}</p>
      <p class="lat-activa">&nbsp;&nbsp;{t('the-colony.md', 'la-colonia.md')}</p>
      <p class="lat-titulo">&nbsp;&nbsp;&nbsp;&nbsp;{t('1. The rain', '1. La lluvia')}</p>
      <p class="lat-titulo actual">&nbsp;&nbsp;&nbsp;&nbsp;{t('2. The tunnel', '2. El túnel')}</p>
      <p class="lat-titulo">&nbsp;&nbsp;&nbsp;&nbsp;{t('3. The queen', '3. La reina')}</p>
      <p>&nbsp;&nbsp;{t('characters.md', 'personajes.md')}</p>
      <p>{t('short-stories', 'cuentos')}</p>
    </div>
    <div class="ventana-editor">
      <p><span class="md">#</span> <b class="h1">{t('2. The tunnel', '2. El túnel')}</b></p>
      <p>&nbsp;</p>
      <p>{t('Nobody in the colony remembered', 'Nadie en la colonia recordaba')}</p>
      <p>{t('who had dug the old tunnel.', 'quién había cavado el túnel viejo.')}</p>
      <p>{t('Mira went in anyway, with', 'Mira entró igual, con las')}</p>
      <p>{t('her antennae low and', 'antenas bajas y el')}</p>
      <p><i>{t('the smell of rain', 'olor a lluvia')}</i> {t('behind her.', 'a la espalda.')}</p>
      <p>&nbsp;</p>
      <p>{t('— Is anyone there?', '—¿Hay alguien ahí?')}<span class="cursor"></span></p>
    </div>
  </div>
  <div class="ventana-estado" aria-hidden="true"><span>{t('the-colony.md *', 'la-colonia.md *')}</span><span>{t('2,431 words', '2.431 palabras')} · 214 {t('lines', 'líneas')}</span></div>
</figure>
