---
// Plantilla de todas las páginas: el sitio es un hormiguero visto en corte. Arriba, la
// superficie (marca y navegación); al centro, el nido: cámaras (`<section class="camara">`)
// unidas por un túnel; abajo, el recorrido: una hormiga que avanza según lo recorrido y un hoyo
// por cámara para saltar a ella.
//
// En la portada (modo `horizontal`) el nido se recorre siguiendo el túnel (`lib/hormiguero.ts`):
// pisos de tres cámaras en zigzag, con la vista bajando suavemente al final de cada piso, y una
// cámara en un ramal al que se llega con un chevron. La rueda, el trackpad, las flechas, Re
// Pág/Av Pág, Inicio y Fin avanzan por el túnel. En pantallas angostas las cámaras van en
// columna, con el scroll vertical normal. Sin JavaScript el nido es una fila horizontal.
//
// En la documentación (modo `vertical`) es una sola cámara gigante con el scroll normal.
//
// El sitio está en inglés y en español: `idioma` elige los textos y el selector EN / ES lleva a
// la misma página en el otro idioma.
import '../styles/global.css';
import Hormiga from '../components/Hormiga.astro';
import { ruta, rutaDe, sitio, traductor, type Idioma, type Seccion } from '../lib/sitio';

interface Props {
  titulo: string;
  descripcion: string;
  seccion: Seccion;
  idioma: Idioma;
  /** `horizontal` (la portada: cámaras en fila) o `vertical` (la documentación: una sola cámara gigante). */
  modo?: 'horizontal' | 'vertical';
}
const { titulo, descripcion, seccion, idioma, modo = 'horizontal' } = Astro.props;
const t = traductor(idioma);
const canonica = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#1d1d20" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={idioma === 'es' ? 'es_CL' : 'en_US'} />
    <meta property="og:url" content={canonica} />
    <link rel="canonical" href={canonica} />
    <link rel="alternate" hreflang="en" href={new URL(rutaDe('en', seccion), Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(rutaDe('es', seccion), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(rutaDe('en', seccion), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={ruta('ant-icono.svg')} />
    <title>{titulo}</title>
  </head>
  <body>
    <a class="saltar" href="#nido">{t('Skip to content', 'Saltar al contenido')}</a>
    <header class="superficie">
      <a class="marca" href={rutaDe(idioma)} aria-label={t('Ant, home', 'Ant, inicio')}>
        <img src={ruta('ant-icono.svg')} width="40" height="40" alt="" />
        <span>Ant</span>
      </a>
      <nav aria-label={t('Main', 'Principal')}>
        <a href={rutaDe(idioma)} aria-current={seccion === 'inicio' ? 'page' : undefined}>{t('Home', 'Inicio')}</a>
        <a href={rutaDe(idioma, 'docs')} aria-current={seccion === 'docs' ? 'page' : undefined}><span class="largo">{t('Documentation', 'Documentación')}</span><span class="corto">Docs</span></a>
        <a class="solo-ancho" href={sitio.repo}>GitHub <span aria-hidden="true">↗</span></a>
        <span class="idiomas" aria-label={t('Language', 'Idioma')}>
          <a href={rutaDe('en', seccion)} lang="en" hreflang="en" aria-current={idioma === 'en' ? 'true' : undefined}>EN</a><span aria-hidden="true">/</span><a href={rutaDe('es', seccion)} lang="es" hreflang="es" aria-current={idioma === 'es' ? 'true' : undefined}>ES</a>
        </span>
      </nav>
    </header>

    <main id="nido" class:list={['nido', modo]} data-modo={modo} tabindex="-1" aria-label={modo === 'horizontal' ? t('Content; scroll to follow the tunnel', 'Contenido; se recorre siguiendo el túnel') : t('Content', 'Contenido')}>
      <div class="fila">
        <slot />
      </div>
    </main>

    {modo === 'horizontal' && (
      <>
        <!-- Chevrons del ramal: el recorrido (lib/hormiguero.ts) los muestra al llegar a la cámara de la que sale el ramal, y en la del ramal. -->
        <button type="button" class="desvio adelante" aria-label={t('Take the side tunnel', 'Tomar el túnel lateral')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        <button type="button" class="desvio atras" aria-label={t('Back to the main tunnel', 'Volver al túnel principal')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
      </>
    )}

    <nav class="recorrido" aria-label={t('Sections of this page', 'Secciones de esta página')}>
      <div class="recorrido-pista">
        <Hormiga class="recorrido-hormiga" />
      </div>
      <ol class="recorrido-hoyos"></ol>
    </nav>

    <script>
      // Recorrido del nido. En la portada lo arma `recorrerHormiguero` (túnel en zigzag, ramal y
      // columna en pantallas angostas); en la documentación el scroll es el normal del navegador.
      // En las dos, la hormiga de abajo avanza según lo recorrido y hay un hoyo por parada para
      // saltar a ella.
      import { cavarHuecos } from '../lib/cavar';
      import { recorrerHormiguero } from '../lib/hormiguero';
      const nido = document.querySelector<HTMLElement>('.nido')!;
      const fila = document.querySelector<HTMLElement>('.fila')!;
      const esLaDocumentacion = nido.dataset.modo === 'vertical';
      const hoyos = document.querySelector<HTMLOListElement>('.recorrido-hoyos')!;
      const hormiga = document.querySelector<SVGElement>('.recorrido-hormiga')!;
      const pista = document.querySelector<HTMLElement>('.recorrido-pista')!;
      const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
      const enlacesDelIndice = [...document.querySelectorAll<HTMLAnchorElement>('.gigante-indice a')];
      // Bordes imperfectos de las cámaras (el túnel lo dibuja el recorrido de la portada).
      cavarHuecos(fila);

      let paradas: HTMLElement[] = [];
      let botonesDeLosHoyos: HTMLButtonElement[] = [];

      /** Un hoyo por parada, con su nombre (`data-nombre`) para lectores de pantalla y al pasar el mouse. */
      const crearHoyos = (nuevasParadas: HTMLElement[], irALaParada: (indice: number) => void) => {
        paradas = nuevasParadas;
        hoyos.replaceChildren();
        botonesDeLosHoyos = paradas.map((parada, i) => {
          const elementoDeLaLista = document.createElement('li');
          const boton = document.createElement('button');
          boton.type = 'button';
          boton.title = parada.dataset.nombre ?? String(i + 1);
          boton.setAttribute('aria-label', boton.title);
          boton.addEventListener('click', () => irALaParada(i));
          elementoDeLaLista.append(boton);
          hoyos.append(elementoDeLaLista);
          return boton;
        });
      };

      // La hormiga avanza por la pista según cuánto se ha recorrido, mira hacia donde va y mueve
      // las patas mientras se mueve; el hoyo (y, en la documentación, el índice) marcan la parada.
      let avanceAnterior = 0;
      let hormigaQuieta: ReturnType<typeof setTimeout> | undefined;
      const mostrarRecorrido = (indiceDeLaParada: number, avance: number) => {
        const espacioDeLaPista = pista.clientWidth - hormiga.getBoundingClientRect().width;
        hormiga.style.setProperty('--x', `${avance * espacioDeLaPista}px`);
        if (avance !== avanceAnterior) {
          hormiga.classList.toggle('atras', avance < avanceAnterior);
          hormiga.classList.add('caminando');
          clearTimeout(hormigaQuieta);
          hormigaQuieta = setTimeout(() => hormiga.classList.remove('caminando'), 160);
        }
        avanceAnterior = avance;
        botonesDeLosHoyos.forEach((boton, i) => boton.toggleAttribute('aria-current', i === indiceDeLaParada));
        enlacesDelIndice.forEach((enlace) => enlace.toggleAttribute('aria-current', enlace.hash === `#${paradas[indiceDeLaParada]?.id}`));
      };

      if (!esLaDocumentacion) {
        recorrerHormiguero(nido, fila, {
          alCambiarLasParadas: crearHoyos,
          alMoverse: mostrarRecorrido,
          botonHaciaElRamal: document.querySelector<HTMLButtonElement>('.desvio.adelante'),
          botonDeVuelta: document.querySelector<HTMLButtonElement>('.desvio.atras'),
        });
      } else {
        /** Posición de una sección dentro del nido, con un respiro antes del borde. */
        const posicionDe = (seccion: HTMLElement) => seccion.getBoundingClientRect().top - nido.getBoundingClientRect().top + nido.scrollTop - 24;
        const irALaSeccion = (indice: number) => {
          const seccion = paradas[Math.max(0, Math.min(paradas.length - 1, indice))];
          nido.scrollTo({ top: posicionDe(seccion), behavior: sinMovimiento.matches ? 'auto' : 'smooth' });
        };
        /** Sección que se está leyendo: la última que empieza antes del primer tercio de la pantalla. */
        const seccionActual = () => {
          if (nido.scrollTop >= nido.scrollHeight - nido.clientHeight - 2) return paradas.length - 1;
          const lineaDeLectura = nido.scrollTop + nido.clientHeight / 3;
          let indice = 0;
          paradas.forEach((seccion, i) => { if (posicionDe(seccion) <= lineaDeLectura) indice = i; });
          return indice;
        };
        const avisar = () => {
          const recorridoMaximo = nido.scrollHeight - nido.clientHeight;
          mostrarRecorrido(seccionActual(), recorridoMaximo > 0 ? nido.scrollTop / recorridoMaximo : 0);
        };
        crearHoyos([...document.querySelectorAll<HTMLElement>('[data-nombre]')], irALaSeccion);
        nido.addEventListener('scroll', avisar, { passive: true });
        window.addEventListener('resize', avisar);

        // Los enlaces a otra sección de la misma página (#install, etc.) se desplazan dentro del nido.
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((enlace) => {
          const destino = document.getElementById(enlace.hash.slice(1));
          if (!destino || enlace.classList.contains('saltar')) return;
          enlace.addEventListener('click', (evento) => {
            evento.preventDefault();
            const indice = paradas.findIndex((seccion) => seccion === destino || seccion.contains(destino));
            if (indice >= 0) irALaSeccion(indice);
            history.replaceState(null, '', enlace.hash);
          });
        });
        // Al llegar con un #ancla en la dirección, se abre en esa sección.
        if (location.hash) {
          const indice = paradas.findIndex((seccion) => seccion.id === decodeURIComponent(location.hash.slice(1)));
          if (indice >= 0) nido.scrollTop = posicionDe(paradas[indice]);
        }
        avisar();
        hormiga.classList.remove('caminando');
      }
      nido.focus({ preventScroll: true });
    </script>
  </body>
</html>
