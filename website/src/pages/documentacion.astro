import Nido from '../layouts/Nido.astro';
import { sitio } from '../lib/sitio';
---
<Nido titulo="Documentación · Ant" descripcion="Cómo instalar y usar Ant: carpeta de trabajo, fijados, atajos, ajustes y cómo compilarla desde el código." seccion="docs">

  <section class="camara" id="indice" data-nombre="Índice">
    <div class="hueco">
      <p class="etiqueta">Documentación</p>
      <h2>Cámaras de este nido</h2>
      <p class="tenue">Avanza hacia la derecha o salta directo a un tema.</p>
      <ol class="indice">
        <li><a href="#instalar">Instalar</a></li>
        <li><a href="#primeros-pasos">Primeros pasos</a></li>
        <li><a href="#escribir">Escribir y guardar</a></li>
        <li><a href="#barra-lateral">Barra lateral</a></li>
        <li><a href="#fijados">Fijados</a></li>
        <li><a href="#buscar">Buscar y reemplazar</a></li>
        <li><a href="#atajos">Atajos</a></li>
        <li><a href="#ajustes">Ajustes</a></li>
