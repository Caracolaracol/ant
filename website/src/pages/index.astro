---
// Portada: una cámara por idea, de izquierda a derecha — qué es Ant, cómo se ve, por qué es
// liviana, qué hace, sus atajos y con qué está hecha.
import Nido from '../layouts/Nido.astro';
import VentanaAnt from '../components/VentanaAnt.astro';
import { ruta, sitio } from '../lib/sitio';
---
<Nido titulo="Ant · notas en Markdown, simples y rápidas" descripcion="Ant es una app de escritorio para tomar notas en Markdown: texto plano en tu disco, una barra lateral con tu carpeta y atajos de teclado. Pesa menos de 5 MB." seccion="inicio">

  <section class="camara portada" id="inicio" data-nombre="Inicio">
    <div class="hueco">
      <img class="portada-icono" src={ruta('ant-icono.svg')} width="220" height="220" alt="Icono de Ant: la cara de una hormiga amarilla" />
      <div>
        <p class="etiqueta">App de notas para el escritorio</p>
        <h1>Ant<span>.</span></h1>
        <p class="lema">Notas en Markdown, simples y rápidas. Tus notas son archivos en tu disco, nada más.</p>
        <div class="acciones">
          <a class="boton lleno" href={ruta('documentacion/#instalar')}>Instalar</a>
          <a class="boton" href={ruta('documentacion/')}>Documentación</a>
          <a class="boton" href={sitio.repo}>GitHub ↗</a>
        </div>
        <p class="pista-scroll">Sigue el túnel <span class="flecha" aria-hidden="true">→</span></p>
      </div>
    </div>
  </section>

  <section class="camara" id="asi-se-ve" data-nombre="Así se ve">
    <div class="hueco bloques">
      <div class="bloque">
        <p class="etiqueta">Así se ve</p>
        <h2>Solo el texto y tu carpeta</h2>
        <p>A la izquierda, tu carpeta de notas y los títulos de la nota abierta, para saltar entre secciones. A la derecha, la nota, con el Markdown a la vista.</p>
        <p class="tenue">Sin cuentas, sin nube, sin base de datos: abre los mismos archivos que Obsidian, VS Code o cualquier editor.</p>
      </div>
      <VentanaAnt />
    </div>
  </section>

  <section class="camara" id="liviana" data-nombre="Liviana">
    <div class="hueco">
      <p class="etiqueta">Liviana como una hormiga</p>
      <h2>Menos de 5 MB</h2>
      <p style="max-width: 52ch">Ant nace de <a href={sitio.left}>Left</a>, de Hundred Rabbits. Left está hecha con Electron y trae un navegador completo adentro. Ant usa Tauri: aprovecha el visor web que ya trae el sistema, así que la app pesa una fracción.</p>
      <div class="peso" role="img" aria-label="Ant pesa 4,7 MB; Left, cerca de 150 MB">
        <div class="ant"><span>Ant</span><i style="width: 3.1%"></i><span>4,7 MB</span></div>
        <div><span>Left</span><i style="width: 100%"></i><span>~150 MB</span></div>
      </div>
    </div>
  </section>

  <section class="camara" id="que-hace" data-nombre="Qué hace">
    <div class="hueco">
      <p class="etiqueta">Qué hace</p>
      <h2>Lo justo para escribir</h2>
      <div class="tarjetas">
        <div class="tarjeta"><h3>Carpeta de trabajo</h3><p>Eliges una carpeta y la barra lateral la muestra como árbol, con sus subcarpetas y notas.</p></div>
        <div class="tarjeta"><h3>Fijados</h3><p>Fija arriba las notas y carpetas que más usas, como las pestañas fijadas de Arc o Zen.</p></div>
        <div class="tarjeta"><h3>Índice de títulos</h3><p>Los <code>#</code> de la nota aparecen bajo su nombre; un clic y saltas a esa sección.</p></div>
        <div class="tarjeta"><h3>Varias notas</h3><p>Abre varias a la vez; cada una recuerda su cursor y su historial de deshacer.</p></div>
        <div class="tarjeta"><h3>Buscar y reemplazar</h3><p>Dentro de la nota, con mayúsculas, palabra completa o expresiones regulares.</p></div>
        <div class="tarjeta"><h3>Guardado seguro</h3><p>Escribe en un archivo temporal y lo renombra: un corte de luz no deja una nota a medias.</p></div>
      </div>
    </div>
  </section>

  <section class="camara" id="atajos" data-nombre="Atajos">
    <div class="hueco">
      <p class="etiqueta">Con el teclado</p>
      <h2>Atajos</h2>
      <dl class="atajos dos">
        <dt><kbd>⌘</kbd> <kbd>N</kbd></dt><dd>Nueva nota</dd>
        <dt><kbd>⌘</kbd> <kbd>O</kbd></dt><dd>Abrir</dd>
        <dt><kbd>⌘</kbd> <kbd>S</kbd></dt><dd>Guardar</dd>
        <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>S</kbd></dt><dd>Guardar como</dd>
        <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>]</kbd></dt><dd>Nota siguiente</dd>
        <dt><kbd>⌘</kbd> <kbd>⇧</kbd> <kbd>[</kbd></dt><dd>Nota anterior</dd>
        <dt><kbd>⌘</kbd> <kbd>\</kbd></dt><dd>Barra lateral</dd>
        <dt><kbd>⌘</kbd> <kbd>,</kbd></dt><dd>Ajustes</dd>
        <dt><kbd>⌘</kbd> <kbd>F</kbd></dt><dd>Buscar</dd>
        <dt><kbd>⌘</kbd> <kbd>Z</kbd></dt><dd>Deshacer</dd>
      </dl>
    </div>
  </section>

  <section class="camara pie" id="hecha-con" data-nombre="Hecha con">
    <div class="hueco">
      <p class="etiqueta">Hecha con</p>
      <h2>Tauri · React · CodeMirror</h2>
      <p>Tauri 2 (Rust) para la ventana y el disco, React con TypeScript y Vite para la interfaz, y CodeMirror 6 como editor de texto.</p>
      <div class="acciones">
        <a class="boton lleno" href={ruta('documentacion/')}>Leer la documentación</a>
        <a class="boton" href={sitio.repo}>Código en GitHub ↗</a>
      </div>
      <p class="tenue" style="margin-top: 24px">Un proyecto de <a href={sitio.portafolio}>{sitio.autor}</a>. Inspirado en <a href={sitio.left}>Left</a>.</p>
    </div>
  </section>

</Nido>
